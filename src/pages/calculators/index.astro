---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorTools } from '../../lib/calculators/metadata';
import VibeAssetCard from '../../components/VibeAssetCard';

const vibeAssets = [
	{
		title: 'Equity ARV Recovery Engine',
		category: 'EQUITY ARV',
		description: 'Underwrite $20k–$150k remodeling projects against hyper-local comp appreciation before signing contractor agreements.',
		metricsPreview: 'Comp ARV = Base Appraised Value + (CapEx × Recovery Rate) - Carry Depreciation',
		slug: 'equity-arv-recovery-engine',
		href: '/calculators/remodeling-roi/'
	},
	{
		title: '5-Year Relocation Friction Ledger',
		category: 'MOVE VS IMPROVE',
		description: 'Compare 8-10% selling commissions, transfer taxes, and interest rate step-ups against expanding your current footprint.',
		metricsPreview: 'Relocation Friction Delta = Net Sale Carry - In-Place Renovation ROI',
		slug: 'relocation-friction-ledger',
		href: '/calculators/move-or-improve/'
	},
	{
		title: 'Remodelytics Multi-Engine Underwriter',
		category: 'CAPEX UNDERWRITING',
		description: 'Pressure-test ADU rental yields, combined LTV ceilings, and contractor over-improvement risk in a single dashboard.',
		metricsPreview: 'MAO Underwriting = (Comp ARV × 70%) - Total CapEx - Financing Friction',
		slug: 'remodelytics-underwriter',
		href: '/calculators/remodelytics/'
	}
];
---

<BaseLayout
	title="Calculators | WellRoost"
	description="Free public calculators and interactive decision engines for homeowners, buyers, and investors making expensive property choices."
>
	<section class="pt-24 sm:pt-32">
		<p class="text-sm font-semibold tracking-wide uppercase text-gray-500">Free Decision Engines</p>
		<h1 class="mt-4 max-w-4xl text-5xl font-bold tracking-tight text-gray-1000 sm:text-6xl">
			Practical money tools for expensive decisions
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
			Start with the numbers. These public calculators are crawlable Astro pages with server-rendered
			titles, copy, and internal links, then React only where the input experience needs to update live.
		</p>
	</section>

	<!-- Interactive Micro-Assets (Vibe Marketing Architecture) -->
	<section class="mt-14" aria-label="Interactive Acquisition Engines">
		<div class="flex items-center justify-between mb-6">
			<div>
				<h2 class="text-xl font-bold tracking-tight text-gray-1000">Interactive Acquisition Engines</h2>
				<p class="text-sm text-gray-600 mt-1">
					Empirical decision tools designed to solve high-stakes property calculations in under 60 seconds.
				</p>
			</div>
			<span class="hidden sm:inline-flex items-center text-xs font-mono uppercase tracking-wider bg-zinc-100 text-zinc-700 px-3 py-1 rounded-full border border-zinc-200">
				Telemetry Enabled
			</span>
		</div>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{vibeAssets.map((asset) => (
				<VibeAssetCard
					client:visible
					title={asset.title}
					category={asset.category}
					description={asset.description}
					metricsPreview={asset.metricsPreview}
					slug={asset.slug}
					href={asset.href}
				/>
			))}
		</div>
	</section>

	<section class="mt-16 grid gap-6 lg:grid-cols-3" aria-label="Calculator library">
		{calculatorTools.map((tool) => (
			<article class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-md">
				<div class="flex items-center justify-between gap-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-primary">{tool.status}</p>
					<span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-medium uppercase tracking-wider text-gray-600">
						Calculator
					</span>
				</div>
				<h2 class="mt-6 text-2xl font-bold tracking-tight text-gray-1000">{tool.title}</h2>
				<p class="mt-3 text-xs font-semibold uppercase tracking-wider text-gray-500">{tool.utility}</p>
				<p class="mt-4 flex-1 text-sm leading-7 text-gray-600">{tool.description}</p>
				<a
					href={tool.href}
					class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-1000 transition hover:text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
				>
					Open calculator
					<span aria-hidden="true">-></span>
				</a>
			</article>
		))}
	</section>
</BaseLayout>
