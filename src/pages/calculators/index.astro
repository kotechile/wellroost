---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorTools } from '../../lib/calculators/metadata';
import { isTelemetryConfigured } from '../../lib/telemetry';
import { vibeAssets } from '../../lib/vibeAssets';

// A claim about the system, derived from the system. It used to render unconditionally while no
// sink was configured, i.e. the page advertised instrumentation that dropped every event.
const telemetryLive = isTelemetryConfigured();

const engines = [
	{
		tool: calculatorTools[1],
		asset: vibeAssets.equityArv,
		takes: 'Project cost, resale lift, years staying, savings, enjoyment.',
		returns: 'Value during your stay, recovery rate, payback, and a verdict.'
	},
	{
		tool: calculatorTools[0],
		asset: vibeAssets.relocationFriction,
		takes: 'Current value, sale friction, next purchase, expansion cost.',
		returns: 'The five-year ledger for staying against moving.'
	},
	{
		tool: calculatorTools[2],
		asset: vibeAssets.remodelytics,
		takes: 'After-repair value, cost, rent, financing, combined loan-to-value.',
		returns: 'Maximum allowable offer and the risk flags that cap it.'
	}
];
---

<BaseLayout
	title="Calculators | WellRoost"
	description="Three free calculators for expensive home decisions: move or improve, remodeling ROI, and a full remodel underwriting model."
>
	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[13ch] text-ink" data-reveal>Three calculators.</h1>
		<div class="mt-8 flex flex-wrap items-end justify-between gap-6">
			<p class="lede max-w-[44ch]" data-reveal style="--reveal-delay:80ms">
				Each runs on your inputs and prints the assumptions it used. No account, no email, no sales
				call at the end.
			</p>
			<p class="text-[0.8125rem] text-ink-2" data-reveal>
				{telemetryLive ? 'Interaction telemetry: on, field names only' : 'Interaction telemetry: no sink configured'}
			</p>
		</div>
	</section>

	<section class="wrap section" aria-label="Calculators">
		<ul class="grid">
			{
				engines.map((engine, index) => (
					<li data-reveal style={`--reveal-delay:${index * 70}ms`}>
						<a
							href={engine.tool.href}
							class="group grid gap-5 py-9 text-ink transition-colors duration-200 hover:text-pine md:grid-cols-[minmax(0,0.95fr)_minmax(0,1fr)] md:gap-12"
						>
							<span>
								<span class="h3 block">{engine.tool.title}</span>
								<span class="mt-2 block max-w-[38ch] text-[1rem] leading-relaxed text-ink-2">
									{engine.tool.description}
								</span>
							</span>
							<span class="grid gap-5 sm:grid-cols-2 md:gap-8">
								<span>
									<span class="block text-[0.8125rem] text-ink-2">Takes</span>
									<span class="mt-1 block max-w-[26ch] text-[1rem] leading-relaxed">
										{engine.takes}
									</span>
								</span>
								<span>
									<span class="block text-[0.8125rem] text-ink-2">Returns</span>
									<span class="mt-1 block max-w-[26ch] text-[1rem] leading-relaxed">
										{engine.returns}
									</span>
									<span class="mt-3 inline-flex items-center gap-2 text-[0.875rem]">
										Open
										<span
											aria-hidden="true"
											class="transition-transform duration-200 group-hover:translate-x-1"
										>
											&rarr;
										</span>
									</span>
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="mt-14 grid gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center" data-reveal>
			<p class="max-w-[52ch] text-[1rem] leading-relaxed text-ink-2">
				The four formulas behind all three, including the weights in the decision score, are
				published on the homepage. Read them before you trust an answer.
			</p>
			<a href="/#method" class="btn-ghost">
				See the formulas
				<span class="arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</section>
</BaseLayout>
