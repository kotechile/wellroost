---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import MoveOrImproveCalculator from '../../components/calculators/react/MoveOrImproveCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';

const calculator = getCalculatorBySlug('move-or-improve');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const quickNotes = [
	{
		title: 'How to read the result',
		body:
			'A positive pathway variance indicates that Renovating (Improving) creates higher net equity over the 5-year holding period, while a negative pathway variance favors Relocating (Moving).'
	},
	{
		title: 'Localized transaction costs',
		body:
			'This calculator automatically models transfer taxes and recordation tax brackets based on your ZIP code (seeding progressive county tax logic for Montgomery County, MD as a default reference).'
	}
];
---

<BaseLayout
	title="Should You Renovate or Move? | Move or Improve Calculator | WellRoost"
	description="Find out whether renovating your home or selling and buying a new one builds more equity over 5 years. Professional-grade side-by-side net equity projection."
>
	<link slot="head" rel="canonical" href={new URL('/calculators/move-or-improve/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell
		eyebrow="Relocation vs Renovation"
		title="Move or Improve Calculator"
		description="Should you renovate your home or sell and buy a new one? This calculator projects your net equity over the next 5 years for both options — side by side — so you can make an informed decision."
	>
		<div slot="calculator">
			<MoveOrImproveCalculator client:load />
		</div>

		<div slot="aside" class="grid gap-6">
			<article class="overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50/80 via-teal-50/40 to-white p-6 shadow-sm">
				<p class="font-mono text-xs uppercase tracking-[0.28em] font-semibold text-emerald-800">How It Works</p>
				<h2 class="mt-3 text-2xl font-bold tracking-tight text-gray-1000">
					5-Year Side-by-Side Comparison
				</h2>
				<p class="mt-4 text-sm leading-7 text-gray-600">
					Unlike simple calculators that use generic national averages, this tool models your actual mortgage amortization, renovation ROI, transaction costs, and home appreciation — all side by side.
				</p>
				<div class="mt-6 rounded-xl border border-emerald-200/70 bg-white/90 p-4 shadow-xs">
					<p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] font-semibold text-emerald-800">
						Why Appreciation Matters
					</p>
					<p class="mt-2 text-sm leading-relaxed text-gray-700">
						High appreciation rates typically favor moving because appreciation applies to a larger base price (e.g. $700k new property vs $500k current property), whereas low growth environments favor staying put due to heavy transaction friction.
					</p>
				</div>
			</article>

			<article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
				<p class="font-mono text-xs uppercase tracking-[0.28em] font-semibold text-emerald-800">Decision Guide</p>
				<div class="mt-5 grid gap-4">
					{quickNotes.map((item) => (
						<div class="rounded-xl border border-gray-200 bg-gray-50/70 p-4">
							<h2 class="text-base font-semibold text-gray-900">{item.title}</h2>
							<p class="mt-2 text-sm leading-relaxed text-gray-600">{item.body}</p>
						</div>
					))}
				</div>
			</article>

			<article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
				<p class="font-mono text-xs uppercase tracking-[0.28em] font-semibold text-gray-600">Formula Reference</p>
				<div class="mt-4 rounded-xl border border-gray-200 bg-gray-50 p-5 font-mono text-xs leading-relaxed text-gray-800">
					<p>V_improve(y) = (V_0 + C_quote × ROI) × (1 + α)^y</p>
					<p class="mt-2">V_move(y) = P_new × (1 + α)^y</p>
					<p class="mt-2">Equity_A = V_improve(5) − LegacyMortgage(60) − HELOC(60)</p>
					<p class="mt-2">Equity_B = V_move(5) − NewMortgage(60)</p>
				</div>
			</article>
		</div>
	</CalculatorShell>
</BaseLayout>


