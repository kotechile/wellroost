---
import CalculatorPage from '../../components/calculators/CalculatorPage.astro';
import FloatingRateCalculator from '../../components/calculators/react/FloatingRateCalculator';
---

<CalculatorPage
	slug="heloc-arm-stress"
	notes={[
		{
			title: 'The interest-rate cap is the whole story',
			body: 'Your adjustable payment is governed by legal caps in your contract. What matters most is the largest increase allowed at one reset (the annual or periodic cap, often 2.00%) and the highest rate allowed over the entire life of the loan (the lifetime cap).'
		},
		{
			title: 'Draw-to-repayment is a second payment shock',
			body: 'On a HELOC, your initial 10-year period is interest-only. When repayment begins, you must start paying back principal over 10 or 20 years. Your monthly bill can jump 30% to 60% even if interest rates do not move at all.'
		},
		{
			title: 'Why a "blocked step" appears in your table',
			body: 'If a projected rate jump exceeds your loan’s lifetime legal limit, the engine labels it as "beyond the ceiling" and caps your payment calculation there, rather than showing a misleading, illegally inflated number.'
		}
	]}
	formula={[
		'Interest-only payment = Loan Balance × (Interest Rate ÷ 12)',
		'Principal + Interest payment = Standard monthly amortization over repayment term',
		'Cushion ceiling = The rate increase (+% or basis points) that fully absorbs your monthly budget buffer',
		'Extra cash needed = Monthly payment increase × 12 months'
	]}
	related={['recast-vs-refinance', 'insurance-coverage-gap', 'rent-vs-buy']}
	disclosure="Nothing here forecasts where market rates will go. The engine tests a fixed ladder of rate increases (+0.25%, +0.50%, +1.00%, and +2.00%) against your contract's exact caps, so you know your payment worst-case before your next bank statement arrives."
>
	<div slot="calculator">
		<FloatingRateCalculator client:load />
	</div>
</CalculatorPage>
