---
import CalculatorPage from '../../components/calculators/CalculatorPage.astro';
import FloatingRateCalculator from '../../components/calculators/react/FloatingRateCalculator';
---

<CalculatorPage
	slug="heloc-arm-stress"
	notes={[
		{
			title: 'HELOC vs. ARM: Basic concepts',
			body: 'A HELOC (Home Equity Line of Credit) is a revolving second mortgage that lets you borrow against your home equity as needed. In contrast, an ARM (Adjustable-Rate Mortgage) is a primary home loan with a fixed rate for an initial period that adjusts periodically. Sources: <a href="https://www.youtube.com/watch?v=92JJKt7avX4" target="_blank" rel="noopener noreferrer" class="text-pine underline hover:text-pine-deep">[1]</a>, <a href="https://www.freedommortgage.com/learn/home-equity/heloc-vs-mortgage" target="_blank" rel="noopener noreferrer" class="text-pine underline hover:text-pine-deep">[2]</a>, <a href="https://www.pennymac.com/blog/heloc-home-equity-line-of-credit" target="_blank" rel="noopener noreferrer" class="text-pine underline hover:text-pine-deep">[3]</a>, <a href="https://www.loandepot.com/learning-center/home-equity/heloc-vs-heloan-which-home-equity-option-is-right-for-you" target="_blank" rel="noopener noreferrer" class="text-pine underline hover:text-pine-deep">[4]</a>, <a href="https://www.lendmire.com/heloc-for-a-homeowner-with-an-arm/" target="_blank" rel="noopener noreferrer" class="text-pine underline hover:text-pine-deep">[5]</a>.'
		},
		{
			title: 'The interest-rate cap is the whole story',
			body: 'Your adjustable payment is governed by legal caps in your contract. The two governing limits are the periodic cap (the max increase at one reset) and the lifetime rate ceiling.'
		},
		{
			title: 'Draw-to-repayment is a second payment shock',
			body: 'On a HELOC, your initial 10-year period is interest-only. When repayment begins, you must start paying back principal over 10 or 20 years. Your monthly bill can jump 30% to 60% even if interest rates do not move at all.'
		},
		{
			title: 'Why a "blocked step" appears in your table',
			body: 'When a projected rate jump exceeds your legal ceiling, the calculation caps there. This avoids displaying an inflated, illegal number.'
		}
	]}
	formula={[
		'Interest-only payment = Loan Balance × (Interest Rate ÷ 12)',
		'Principal + Interest payment = Standard monthly amortization over repayment term',
		'Cushion ceiling = The rate increase (+% or basis points) that fully absorbs your monthly budget buffer',
		'Extra cash needed = Monthly payment increase × 12 months'
	]}
	related={['recast-vs-refinance', 'insurance-coverage-gap', 'rent-vs-buy']}
	disclosure="Nothing here forecasts where market rates will go. The engine tests a fixed ladder of rate increases (+0.25%, +0.50%, +1.00%, and +2.00%) against your contract's exact caps, so you know your payment worst-case before your next bank statement arrives."
>
	<div slot="calculator">
		<FloatingRateCalculator client:load />
	</div>
</CalculatorPage>
