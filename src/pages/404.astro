---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page not found | WellRoost"
	description="That page is not on WellRoost. Start with the calculators or the pillar index."
	noindex
>
	<section class="wrap py-[clamp(4rem,12vw,9rem)]">
		<h1 class="display max-w-[12ch] text-ink">This page is not here.</h1>
		<p class="lede mt-8 max-w-[38ch]">
			Either it moved, or it never existed. The calculators are the part of this site that answers a
			question today.
		</p>
		<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
			<a href="/calculators/" class="btn">
				Run a number
				<span aria-hidden="true">&rarr;</span>
			</a>
			<a href="/categories/" class="btn-ghost">
				Browse the pillars
				<span class="arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</section>
</BaseLayout>
