---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found | WellRoost"
	description="That page is not on WellRoost. Browse the calculators or the category index to find what you were looking for."
	noindex
>
	<div class="py-20 text-center">
		<h1 class="text-4xl font-bold">404 - Page Not Found</h1>
		<p class="mt-4 text-base text-gray-600">
			<a class="font-semibold text-primary hover:underline" href="/calculators/">Browse calculators</a>
			<span class="mx-2 text-gray-300">·</span>
			<a class="font-semibold text-primary hover:underline" href="/categories/">Browse categories</a>
		</p>
	</div>
</BaseLayout>
