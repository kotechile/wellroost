---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';

const categories = await getTopLevelCategories();

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const pageUrl = new URL('/categories/', siteUrl).toString();

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Categories | WellRoost",
	"description": "Browse editorial pillars and home decision guides on WellRoost.",
	"url": pageUrl,
	"numberOfItems": categories.length,
	"itemListElement": categories.map((cat, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": cat.name,
		"url": new URL(`/categories/${cat.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Categories",
			"item": pageUrl
		}
	]
};
---

<BaseLayout
	title="Categories | WellRoost"
	description="Browse editorial pillars for high-ROI home investments, remodeling strategy, and system optimization."
>
	<link slot="head" rel="canonical" href={new URL('/categories/', Astro.site).toString()} />
	<JsonLd slot="head" data={collectionSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<div class="relative py-12 sm:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="section-eyebrow">Decision Pillars</p>
			<h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-1000">
				Explore Knowledge by Pillar
			</h1>
			<p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
				In-depth articles, practical frameworks, and calculators categorized by property and lifestyle decision areas.
			</p>
		</div>

		<div class="mx-auto mt-12 max-w-5xl grid gap-6 sm:grid-cols-2">
			{categories.map((category) => (
				<a
					href={`/categories/${category.slug}/`}
					class="group relative flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-8 transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary shadow-sm"
				>
					<div>
						<div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-primary group-hover:bg-blue-100 transition-colors">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2" />
							</svg>
						</div>
						<h2 class="text-2xl font-bold text-gray-1000 tracking-tight group-hover:text-primary transition-colors">
							{category.name}
						</h2>
						<p class="mt-3 text-sm leading-relaxed text-gray-600">
							{category.description || 'Guides, templates, and analytics to support decision-making in this area.'}
						</p>
					</div>
					<div class="mt-8 flex items-center justify-between pt-4 border-t border-gray-100">
						<span class="text-xs font-mono font-medium uppercase tracking-wider text-gray-400">
							{category.postCount !== null ? `${category.postCount} Articles` : 'Guides'}
						</span>
						<span class="text-sm font-semibold text-primary flex items-center gap-1">
							Open Pillar <span aria-hidden="true" class="transition group-hover:translate-x-1 inline-block">&rarr;</span>
						</span>
					</div>
				</a>
			))}
		</div>
	</div>
</BaseLayout>
