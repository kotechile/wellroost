---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';

const categories = await getTopLevelCategories();
const total = categories.reduce((sum, category) => sum + (category.postCount ?? 0), 0);

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const pageUrl = new URL('/categories/', siteUrl).toString();

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'name': 'Pillars | WellRoost',
	'description': 'The four decision pillars behind WellRoost.',
	'url': pageUrl,
	'numberOfItems': categories.length,
	'itemListElement': categories.map((cat, idx) => ({
		'@type': 'ListItem',
		'position': idx + 1,
		'name': cat.name,
		'url': new URL(`/categories/${cat.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': [
		{ '@type': 'ListItem', 'position': 1, name: 'Home', item: siteUrl },
		{ '@type': 'ListItem', 'position': 2, name: 'Pillars', item: pageUrl }
	]
};
---

<BaseLayout
	title="Pillars | WellRoost"
	description="Four pillars, one per kind of expense a house hands you: home finances, renovations, energy systems and equipment."
>
	<JsonLd slot="head" data={collectionSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[14ch] text-ink" data-reveal>Four pillars.</h1>
		<p class="lede mt-8 max-w-[46ch]" data-reveal style="--reveal-delay:80ms">
			One per kind of expense a house hands you. Each guide works a decision through the same
			arithmetic the calculators run.
		</p>
	</section>

	<section class="wrap section" aria-label="Pillars">
		<ul class="grid">
			{
				categories.map((category, index) => (
					<li data-reveal style={`--reveal-delay:${index * 70}ms`}>
						<a
							href={`/categories/${category.slug}/`}
							class="group grid items-baseline gap-3 py-8 text-ink transition-colors duration-200 hover:text-pine sm:gap-8 md:grid-cols-[minmax(0,0.55fr)_minmax(0,1fr)_auto]"
						>
							<h2 class="h3 max-w-[20ch]">{category.name}</h2>
							<p class="body max-w-[42ch]">
								{category.description || 'Guides for this pillar are being written.'}
							</p>
							<p class="num text-[0.8125rem] text-ink-2">
								{category.postCount
									? `${category.postCount} ${category.postCount === 1 ? 'guide' : 'guides'}`
									: 'In progress'}
							</p>
						</a>
					</li>
				))
			}
		</ul>

		<p class="mt-12 max-w-[52ch] text-[1rem] leading-relaxed text-ink-2" data-reveal>
			{
				total > 0
					? 'Every guide here is written against the published formulas and links to the calculator it describes.'
					: 'The archive is empty while the first batch is written and checked. The three calculators are live now.'
			}
		</p>
	</section>
</BaseLayout>
