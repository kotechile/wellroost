---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';
import { fetchPostsByCategory } from '../../lib/wordpress';
import { getSubjectImage } from '../../lib/subjectImages';

const categories = await getTopLevelCategories();

// Subject, its own photograph, and the newest pieces in it. Compact: a reader should be able to
// scan four subjects and a dozen headlines without scrolling through posters.
const groups = await Promise.all(
	categories.map(async (category) => ({
		category,
		cover: getSubjectImage(category.slug),
		recent: category.wordpressCategoryId
			? await fetchPostsByCategory(category.wordpressCategoryId, 3)
			: []
	}))
);

const total = categories.reduce((sum, category) => sum + (category.postCount ?? 0), 0);

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const pageUrl = new URL('/categories/', siteUrl).toString();

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'name': 'Articles | WellRoost',
	'description': 'Every WellRoost article, grouped by the four home decisions it belongs to.',
	'url': pageUrl,
	'numberOfItems': categories.length,
	'itemListElement': categories.map((cat, idx) => ({
		'@type': 'ListItem',
		'position': idx + 1,
		'name': cat.name,
		'url': new URL(`/categories/${cat.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': [
		{ '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': siteUrl },
		{ '@type': 'ListItem', 'position': 2, 'name': 'Articles', 'item': pageUrl }
	]
};
---

<BaseLayout
	title="Articles | WellRoost"
	description="Every WellRoost article, grouped by the four home decisions it belongs to: energy and efficiency, home cost decisions, smart home and security, tools and equipment."
>
	<JsonLd slot="head" data={collectionSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[12ch] text-ink" data-reveal>Articles.</h1>
		<p class="lede mt-8 max-w-[44ch]" data-reveal style="--reveal-delay:80ms">
			{total > 0 ? `${total} pieces,` : 'Every piece here,'} sorted by the kind of expense that caused
			them. Each one works a decision through the same arithmetic the calculators run.
		</p>
	</section>

	<section class="wrap section" aria-label="Articles by subject">
		<ul class="grid gap-10">
			{
				groups.map(({ category, cover, recent }, index) => (
					<li data-reveal style={`--reveal-delay:${index * 60}ms`}>
						<a
							href={`/categories/${category.slug}/`}
							class="group grid items-center gap-4 bg-card p-4 text-ink transition-colors duration-200 hover:bg-paper-2 sm:gap-6 sm:p-5 md:grid-cols-[10rem_minmax(0,0.85fr)_minmax(0,1fr)_auto]"
						>
							{cover ? (
								<span class="block aspect-[4/3] w-full overflow-hidden bg-paper-3 md:w-[10rem]">
									<Image
										src={cover.src}
										alt={cover.alt}
										widths={[320, 480, 640]}
										sizes="10rem"
										loading="lazy"
										class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
									/>
								</span>
							) : (
								<span class="block aspect-[4/3] w-full bg-paper-3 md:w-[10rem]" />
							)}

							<span class="h3 max-w-[18ch] transition-colors duration-200 group-hover:text-pine">
								{category.name}
							</span>

							<span class="max-w-[48ch] text-[0.9375rem] leading-relaxed text-ink-2 line-clamp-2">
								{category.description}
							</span>

							<span class="flex items-baseline gap-4 text-[0.8125rem] text-ink-2">
								<span class="num">
									{category.postCount
										? `${category.postCount} ${category.postCount === 1 ? 'piece' : 'pieces'}`
										: 'In progress'}
								</span>
								<span
									aria-hidden="true"
									class="text-pine transition-transform duration-200 group-hover:translate-x-1"
								>
									&rarr;
								</span>
							</span>
						</a>

						{recent.length > 0 && (
							<ul class="mt-2 grid gap-1 md:pl-[11.25rem]">
								{recent.map((item, row) => (
									<li data-reveal style={`--reveal-delay:${row * 50}ms`}>
										<a
											href={`/${item.slug}/`}
											class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-1 py-2 text-ink transition-colors duration-150 hover:text-pine"
										>
											<span class="max-w-[52ch] text-[0.9375rem] leading-snug">{item.title}</span>
											<span class="num text-[0.8125rem] text-ink-2">
												{item.date
													? new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
													: ''}
											</span>
										</a>
									</li>
								))}
								{category.postCount && category.postCount > recent.length && (
									<li>
										<a
											href={`/categories/${category.slug}/`}
											class="px-1 py-2 text-[0.8125rem] text-pine transition-opacity hover:opacity-70"
										>
											All {category.postCount} pieces
										</a>
									</li>
								)}
							</ul>
						)}
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
