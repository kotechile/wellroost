---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';
import { fetchPostsByCategory } from '../../lib/wordpress';

const categories = await getTopLevelCategories();

// One representative picture per subject: the newest piece in that category. The CMS only carries a
// share card per article, so that is what the tile shows — at this size it reads as photography.
// The newest piece in each subject, shown whole: the CMS's featured image is the article's own
// poster with its headline set into it, so cropping it chops the type. Shown uncropped and named in
// a caption, the headline inside the picture is the thing the caption refers to.
const latestBySlug = Object.fromEntries(
	await Promise.all(
		categories.map(async (category) => {
			if (!category.wordpressCategoryId) return [category.slug, null] as const;
			const [latest] = await fetchPostsByCategory(category.wordpressCategoryId, 1);
			return [
				category.slug,
				latest?.featuredImage ? { image: latest.featuredImage, title: latest.title, slug: latest.slug } : null
			] as const;
		})
	)
);

const total = categories.reduce((sum, category) => sum + (category.postCount ?? 0), 0);

const tiles = categories.map((category) => ({
	category,
	cover: latestBySlug[category.slug]
}));

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const pageUrl = new URL('/categories/', siteUrl).toString();

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'name': 'Articles | WellRoost',
	'description': 'Every WellRoost article, grouped by the four home decisions it belongs to.',
	'url': pageUrl,
	'numberOfItems': categories.length,
	'itemListElement': categories.map((cat, idx) => ({
		'@type': 'ListItem',
		'position': idx + 1,
		'name': cat.name,
		'url': new URL(`/categories/${cat.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': [
		{ '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': siteUrl },
		{ '@type': 'ListItem', 'position': 2, 'name': 'Articles', 'item': pageUrl }
	]
};
---

<BaseLayout
	title="Articles | WellRoost"
	description="Every WellRoost article, grouped by the four home decisions it belongs to: energy and efficiency, home cost decisions, smart home and security, tools and equipment."
>
	<JsonLd slot="head" data={collectionSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[12ch] text-ink" data-reveal>Articles.</h1>
		<p class="lede mt-8 max-w-[44ch]" data-reveal style="--reveal-delay:80ms">
			{total > 0 ? `${total} pieces,` : 'Every piece here,'} each working one home decision through the
			same arithmetic the calculators run. Sorted by the kind of expense that causes it.
		</p>
	</section>

	<section class="wrap section" aria-label="Article subjects">
		<div class="grid gap-8 sm:grid-cols-2 sm:gap-10">
			{
				tiles.map(({ category, cover }, index) => (
					<a
						href={`/categories/${category.slug}/`}
						class="group flex flex-col bg-card text-ink transition-colors duration-200 hover:bg-paper-2"
						data-reveal
						style={`--reveal-delay:${index * 70}ms`}
					>
						{cover ? (
							<>
								<div class="aspect-[16/9] w-full overflow-hidden bg-paper-3">
									<img
										src={cover.image}
										alt=""
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
									/>
								</div>
								<p class="line-clamp-1 px-6 pt-4 text-[0.8125rem] text-ink-2">
									<span class="text-pine">Latest</span>
									<span aria-hidden="true"> · </span>
									{cover.title}
								</p>
							</>
						) : (
							<div class="aspect-[16/9] w-full bg-paper-3" />
						)}

						<div class="flex flex-1 flex-col justify-between gap-5 p-6 pt-3">
							<div>
								<h2 class="h3 max-w-[18ch] text-ink transition-colors duration-200 group-hover:text-pine">
									{category.name}
								</h2>
								<p class="mt-3 max-w-[42ch] text-[0.9375rem] leading-relaxed text-ink-2 line-clamp-3">
									{category.description || 'Pieces for this subject are being written.'}
								</p>
							</div>

							<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.8125rem]">
								<span class="num text-ink-2">
									{category.postCount
										? `${category.postCount} ${category.postCount === 1 ? 'piece' : 'pieces'}`
										: 'In progress'}
								</span>
								<span class="inline-flex items-center gap-2 text-pine">
									Open
									<span
										aria-hidden="true"
										class="transition-transform duration-200 group-hover:translate-x-1"
									>
										&rarr;
									</span>
								</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>