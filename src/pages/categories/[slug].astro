---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllCategories, getCategoryBySlug } from '../../lib/categories';
import { fetchPostsByCategory } from '../../lib/wordpress';

export async function getStaticPaths() {
	const categories = await getAllCategories();
	return categories.map((category) => ({
		params: { slug: category.slug }
	}));
}

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : null;

if (!category) {
	return Astro.redirect('/404');
}

const posts = category.wordpressCategoryId
	? await fetchPostsByCategory(category.wordpressCategoryId, 20)
	: [];

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const categoriesUrl = new URL('/categories/', siteUrl).toString();
const categoryUrl = new URL(`/categories/${category.slug}/`, siteUrl).toString();

const categorySchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'name': `${category.name} | WellRoost`,
	'description': category.description || `Guides about ${category.name}.`,
	'url': categoryUrl,
	'numberOfItems': posts.length,
	'itemListElement': posts.map((post, idx) => ({
		'@type': 'ListItem',
		'position': idx + 1,
		'name': post.title,
		'url': new URL(`/${post.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': [
		{ '@type': 'ListItem', 'position': 1, name: 'Home', item: siteUrl },
		{ '@type': 'ListItem', 'position': 2, name: 'Articles', item: categoriesUrl },
		{ '@type': 'ListItem', 'position': 3, name: category.name, item: categoryUrl }
	]
};
---

<BaseLayout
	title={`${category.name} | WellRoost`}
	description={category.description || `Guides about ${category.name}.`}
>
	<JsonLd slot="head" data={categorySchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[16ch] text-ink" data-reveal>{category.name}</h1>
		<div class="mt-7 flex flex-wrap items-end justify-between gap-6">
			<p class="lede max-w-[46ch]" data-reveal style="--reveal-delay:80ms">
				{category.description || 'Pieces for this subject are being written.'}
			</p>
			<a
				href="/categories/"
				class="btn-ghost pb-1"
				data-reveal
			>
				<span aria-hidden="true">&larr;</span> All articles
			</a>
		</div>
	</section>

	<section class="wrap section" aria-label={`${category.name} guides`}>
		{
			posts.length ? (
				<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
					{posts.map((post, index) => (
						<div data-reveal style={`--reveal-delay:${(index % 3) * 70}ms`}>
							<PostCard post={post} />
						</div>
					))}
				</div>
			) : (
				<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
					<div>
						<h2 class="h2 max-w-[18ch] text-ink" data-reveal>Nothing published here yet.</h2>
						<p class="body mt-6 max-w-[42ch]" data-reveal>
							Guides are written against the published formulas and checked before they go up. The
							calculators that do the same arithmetic are live now.
						</p>
					</div>
					<a href="/calculators/" class="btn" data-reveal>
						Run a number
						<span aria-hidden="true">&rarr;</span>
					</a>
				</div>
			)
		}
	</section>
</BaseLayout>
