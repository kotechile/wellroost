---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getAllCategories, getCategoryBySlug } from '../../lib/categories';
import { fetchPostsByCategory } from '../../lib/wordpress';

export async function getStaticPaths() {
	const categories = await getAllCategories();
	return categories.map((category) => ({
		params: { slug: category.slug }
	}));
}

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : null;

if (!category) {
	return Astro.redirect('/404');
}

const posts = category.wordpressCategoryId
	? await fetchPostsByCategory(category.wordpressCategoryId, 20)
	: [];

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const categoriesUrl = new URL('/categories/', siteUrl).toString();
const categoryUrl = new URL(`/categories/${category.slug}/`, siteUrl).toString();

const categorySchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": `${category.name} | WellRoost`,
	"description": category.description || `Browse articles, guides, and tools related to ${category.name}.`,
	"url": categoryUrl,
	"numberOfItems": posts.length,
	"itemListElement": posts.map((post, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": post.title,
		"url": new URL(`/${post.slug}/`, siteUrl).toString()
	}))
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Categories",
			"item": categoriesUrl
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": category.name,
			"item": categoryUrl
		}
	]
};
---

<BaseLayout
	title={`${category.name} | WellRoost`}
	description={category.description || `Browse articles, guides, and tools related to ${category.name}.`}
>
	<link slot="head" rel="canonical" href={categoryUrl} />
	<JsonLd slot="head" data={categorySchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<div class="relative py-12 sm:py-16">
		<div class="mx-auto max-w-4xl">
			<a href="/categories/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary mb-6 hover:underline">
				<span aria-hidden="true">&larr;</span> Back to all categories
			</a>
			
			<p class="section-eyebrow">Decision Pillar</p>
			<h1 class="mt-2 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-1000">
				{category.name}
			</h1>
			<p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed max-w-3xl">
				{category.description || 'Guides, templates, and analytics to support home decision-making in this area.'}
			</p>
		</div>

		<div class="mx-auto mt-12 max-w-5xl">
			{posts.length ? (
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<a
							href={`/${post.slug}/`}
							class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary shadow-sm"
						>
							<div>
								{post.featuredImage ? (
									<div class="aspect-video w-full overflow-hidden rounded-xl border border-gray-100 bg-gray-50 mb-4">
										<img
											src={post.featuredImage}
											alt={post.featuredImageAlt || ''}
											loading="lazy"
											class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
										/>
									</div>
								) : (
									<div class="aspect-video w-full bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-center text-gray-300 mb-4">
										<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 00-2-2m-2-3V3m8 8h-6M21 12H9m0 0v-4" />
										</svg>
									</div>
								)}
								<div>
									<div class="flex items-center gap-2 font-mono text-[11px] uppercase text-gray-400 mb-2">
										<span>{post.date ? new Date(post.date).toLocaleDateString() : 'Live'}</span>
									</div>
									<h2 class="text-xl font-bold leading-snug text-gray-1000 transition group-hover:text-primary">
										{post.title}
									</h2>
									<p class="mt-2.5 text-sm leading-relaxed text-gray-600 line-clamp-3">
										{post.excerpt}
									</p>
								</div>
							</div>
							<div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-primary">
								<span>Read Guide</span>
								<span aria-hidden="true" class="transition group-hover:translate-x-1 inline-block">&rarr;</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="rounded-2xl border border-gray-200 bg-white p-12 text-center shadow-sm">
					<div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-gray-400 mb-3">
						<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 00-2-2m-2-3V3m8 8h-6M21 12H9m0 0v-4" /></svg>
					</div>
					<h3 class="text-lg font-bold text-gray-900">No Guides Published Yet</h3>
					<p class="mt-1 text-sm text-gray-500 max-w-sm mx-auto">
						Articles in this category are being prepared. Check back soon or browse our interactive calculators.
					</p>
					<div class="mt-6">
						<a href="/calculators/" class="btn-primary text-xs py-2 px-4 h-auto">
							Explore Calculators
						</a>
					</div>
				</div>
			)}
		</div>
	</div>
</BaseLayout>
