---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import PlateBand from '../components/home/PlateBand.astro';
import Argument from '../components/home/Argument.astro';
import EngineRows from '../components/home/EngineRows.astro';
import CandyHome from '../components/home/CandyHome.astro';
import MethodSpread from '../components/home/MethodSpread.astro';
import PillarIndex from '../components/home/PillarIndex.astro';
import LatestArticles from '../components/home/LatestArticles.astro';
import CloseCta from '../components/home/CloseCta.astro';
import { getTopLevelCategories } from '../lib/categories';
import { fetchLatestPosts } from '../lib/wordpress';

const topCategories = await getTopLevelCategories();
const posts = await fetchLatestPosts(3);

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'WellRoost',
	alternateName: 'WellRoost Home Decision Engine',
	url: siteUrl,
	potentialAction: {
		'@type': 'SearchAction',
		target: `${siteUrl}?s={search_term_string}`,
		'query-input': 'required name=search_term_string'
	}
};
---

<BaseLayout
	title="WellRoost | Run the number before you sign"
	description="Three calculators for expensive home decisions: move or improve, remodel cost against resale lift, and full remodel underwriting. Every formula published."
>
	<JsonLd slot="head" data={websiteSchema} />

	<Hero />

	<PlateBand plate="house" priority note="Housing stock, 1937. Not a property we have modelled." />

	<Argument />
	<EngineRows />
	<CandyHome />
	<MethodSpread />
	<PillarIndex categories={topCategories} postCount={posts.length} />
	<LatestArticles />

	<PlateBand
		plate="porch"
		height="h-[34vh] min-h-[16rem] sm:h-[42vh] lg:h-[46vh]"
		note="Detail is where a quote is decided."
	/>

	<CloseCta />
</BaseLayout>
