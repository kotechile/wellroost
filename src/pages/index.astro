---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBento from '../components/CategoryBento.astro';
import LatestPostsGrid from '../components/LatestPostsGrid.astro';
import JsonLd from '../components/JsonLd.astro';
import { getTopLevelCategories } from '../lib/categories';
import { calculatorTools } from '../lib/calculators/metadata';
import { fetchPostsByCategory } from '../lib/wordpress';

const topCategories = await getTopLevelCategories();
const categoryPosts = Object.fromEntries(
	await Promise.all(
		topCategories.map(async (category) => [
			category.slug,
			category.wordpressCategoryId ? await fetchPostsByCategory(category.wordpressCategoryId, 6) : []
		])
	)
);

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "WellRoost",
	"alternateName": "WellRoost Home Decision Engine",
	"url": siteUrl,
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${siteUrl}?s={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};
---

<BaseLayout
	title="WellRoost | The Decision Engine for Your Home"
	description="WellRoost takes the guesswork out of homeownership with interactive calculators and data-driven insights."
>
	<link slot="head" rel="canonical" href={new URL('/', Astro.site).toString()} />
	<JsonLd slot="head" data={websiteSchema} />
	
	<!-- Hero Section -->
	<section class="mt-20 sm:mt-28 pb-12 text-center">
		<p class="section-eyebrow mb-4">Empowering Smart Property Decisions</p>
		<h1 class="mx-auto max-w-4xl text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-1000 leading-[1.12]">
			Welcome to WellRoost—<br />
			<span class="text-gray-400 font-semibold">The Decision Engine for Your Home.</span>
		</h1>
		<p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-gray-600">
			WellRoost takes the guesswork out of homeownership. Built around a core ecosystem of interactive calculators and data-driven insights, we help you make objective, high-ROI choices for your property, budget, and lifestyle.
		</p>
		<div class="mt-8 flex items-center justify-center gap-x-4">
			<a href="/calculators/" class="btn-primary">
				Start calculating
			</a>
			<a href="/categories/" class="btn-secondary">
				Browse guides &rarr;
			</a>
		</div>
	</section>

	<!-- Interactive Calculators Section -->
	<section class="mt-16" aria-labelledby="homepage-calculators">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="section-eyebrow">Calculators</p>
				<h2 id="homepage-calculators" class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-gray-1000">
					Quantify high-stakes property decisions
				</h2>
			</div>
			<a href="/calculators/" class="text-sm font-semibold text-primary transition hover:underline">
				Browse all calculators <span aria-hidden="true">&rarr;</span>
			</a>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-3">
			{calculatorTools.map((tool) => (
				<a
					href={tool.href}
					class="group flex min-h-60 flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary shadow-sm"
				>
					<div>
						<div class="flex items-center justify-between">
							<div class="rounded-xl bg-blue-50 border border-blue-100 p-2.5 text-primary group-hover:bg-blue-100 transition-colors">
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M7 4v6m10-6v6M6 14h4v4H6v-4Zm8 0h4v4h-4v-4Z" />
								</svg>
							</div>
							<span class="font-mono text-xs uppercase tracking-wider text-gray-400 font-medium">Free Tool</span>
						</div>
						<h3 class="mt-4 text-lg font-bold text-gray-1000 group-hover:text-primary transition-colors">{tool.title}</h3>
						<p class="mt-1 text-xs font-mono uppercase tracking-wider text-gray-500">{tool.utility}</p>
						<p class="mt-3 text-sm leading-relaxed text-gray-600 line-clamp-2">{tool.description}</p>
					</div>
					<div class="mt-5 pt-3 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-primary">
						<span>Open {tool.title}</span>
						<span class="inline-block transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- Categories & Live Articles Bento Grid -->
	<CategoryBento categories={topCategories} postsByCategory={categoryPosts} />
	
	<!-- Latest Posts Feed from CMS -->
	<LatestPostsGrid />

	<!-- Call to Action -->
	<section class="mt-28 mb-16 rounded-3xl bg-gray-1000 p-10 sm:p-14 text-center text-white shadow-xl">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Stop guessing. Start calculating.</h2>
		<p class="mx-auto mt-4 max-w-xl text-base text-gray-300 leading-relaxed">
			Whether you're deciding on a major remodel, heat pump conversion, or weighing move vs. improve, get objective clarity.
		</p>
		<div class="mt-8 flex justify-center gap-4">
			<a href="/calculators/" class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-bold text-gray-1000 transition hover:bg-gray-100 shadow-sm">
				Browse Calculators
			</a>
			<a href="/categories/" class="inline-flex items-center justify-center rounded-xl border border-gray-700 bg-gray-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-800">
				Browse Knowledge Base
			</a>
		</div>
	</section>
</BaseLayout>
