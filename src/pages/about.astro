---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { plates } from '../lib/plates';

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const pageUrl = new URL('/about/', siteUrl).toString();

const aboutSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	'name': 'About WellRoost',
	'description': 'The mission, the math and the limits behind WellRoost.',
	'url': pageUrl,
	'mainEntity': {
		'@type': 'Organization',
		'name': 'WellRoost',
		'url': siteUrl,
		'logo': new URL('/favicon.svg', siteUrl).toString(),
		'description':
			'Calculators and editorial guides for high-stakes homeownership and remodeling decisions.'
	}
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': [
		{ '@type': 'ListItem', 'position': 1, name: 'Home', item: siteUrl },
		{ '@type': 'ListItem', 'position': 2, name: 'About', item: pageUrl }
	]
};

const audience = [
	{
		title: 'The renovator',
		body: 'Weighing a $20,000 to $150,000 project against after-repair value, and trying not to overbuild the street.'
	},
	{
		title: 'The move-or-improve household',
		body: 'Comparing the five-year ledger of selling and buying again against adding the space where you already live.'
	},
	{
		title: 'The systems owner',
		body: 'Financing a heat pump, solar or insulation, and needing the payback horizon before the installer leaves.'
	},
	{
		title: 'The investor',
		body: 'Underwriting a purchase with the 70% rule, combined loan-to-value and rental income that has to survive the mortgage.'
	}
];

const principles = [
	{
		title: 'Every formula is on the page',
		body: 'Recovery, payback, the enjoyment credit and the weights behind the score are printed next to the answer. If the output looks wrong, you can check it without asking us.'
	},
	{
		title: 'No lead selling, no inflated lift',
		body: 'The calculators do not route you to a contractor, an agent or a lender, and no resale figure is tuned to make a decision look better.'
	},
	{
		title: 'Total cost, not sticker price',
		body: 'Commissions, financing carry, utility offsets and the years you plan to stay all enter the model, because they are what separate a project from an investment.'
	}
];
---

<BaseLayout
	title="About WellRoost | The decision engine for your home"
	description="Why WellRoost exists, what the four equations do, and where the calculators stop being reliable."
>
	<JsonLd slot="head" data={aboutSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="wrap pt-[clamp(2rem,5vw,4rem)]">
		<h1 class="display max-w-[16ch] text-ink" data-reveal>The decision engine for your home.</h1>
		<div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-20">
			<p class="statement text-ink" data-reveal style="--reveal-delay:80ms">
				A house is a series of expensive decisions in sequence, and most of them get made on a
				feeling.
			</p>
			<div class="grid gap-4" data-reveal style="--reveal-delay:140ms">
				<p class="body max-w-[44ch]">
					WellRoost exists to put a number in front of the ones that cost the most. Not a score out
					of ten, and not a lead form: the cost, the resale lift, the gap you carry, and the years it
					takes to close.
				</p>
				<p class="body max-w-[44ch]">
					Three calculators do that today. Editorial guides are being written into four pillars, and
					none of them ships until the arithmetic it describes is the arithmetic that runs.
				</p>
			</div>
		</div>
	</section>

	<figure class="bleed mt-[clamp(3rem,6vw,5rem)]">
		<div class="h-[38vh] min-h-[16rem] overflow-hidden bg-paper-3 sm:h-[46vh]" data-reveal>
			<Image
				src={plates.mantel.src}
				alt={plates.mantel.alt}
				widths={[1080, 1600, 2200]}
				sizes="100vw"
				loading="lazy"
				class="plate plate-warm h-full w-full object-cover"
			/>
		</div>
		<figcaption class="wrap mt-3 caption">{plates.mantel.credit}</figcaption>
	</figure>

	<section class="section wrap" aria-labelledby="name">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] lg:gap-20">
			<h2 id="name" class="h2 max-w-[14ch] text-ink" data-reveal>Two words, one thesis.</h2>
			<div class="grid gap-10 sm:grid-cols-2" data-reveal style="--reveal-delay:80ms">
				<div>
					<p class="figure text-[clamp(2rem,3.2vw,2.8rem)] text-pine">Well</p>
					<p class="body mt-3">
						Low running costs, working systems, and a household that is not paying for energy it
						does not use.
					</p>
				</div>
				<div>
					<p class="figure text-[clamp(2rem,3.2vw,2.8rem)] text-pine">Roost</p>
					<p class="body mt-3">
						The equity you are sitting on, and the reason a bad decision here costs more than a bad
						decision anywhere else.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="wrap" aria-labelledby="audience">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] lg:gap-20">
			<h2 id="audience" class="h2 max-w-[16ch] text-ink" data-reveal>Who the math is for.</h2>
			<ul class="grid">
				{
					audience.map((item, index) => (
						<li
							class="grid gap-1 py-5 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8"
							data-reveal
							style={`--reveal-delay:${index * 60}ms`}
						>
							<p class="font-display text-[1.3rem] leading-tight text-ink">{item.title}</p>
							<p class="body max-w-[44ch]">{item.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="field-dark section mt-[var(--section-space)]" aria-labelledby="principles">
		<div class="wrap">
			<h2 id="principles" class="h2 max-w-[18ch] text-paper" data-reveal>The rules we hold to.</h2>
			<ul class="mt-12 grid gap-10 lg:grid-cols-3 lg:gap-12">
				{
					principles.map((item, index) => (
						<li data-reveal style={`--reveal-delay:${index * 70}ms`}>
							<h3 class="font-display text-[1.5rem] leading-tight text-paper">{item.title}</h3>
							<p class="mt-3 max-w-[38ch] text-[1rem] leading-relaxed text-paper/70">
								{item.body}
							</p>
						</li>
					))
				}
			</ul>
			<p class="mt-12 max-w-[52ch] text-[1rem] leading-relaxed text-paper/60" data-reveal>
				Where the calculators stop: no live comparables, no contractor pricing by ZIP, no loan
				program rules. Those gaps are named on each engine page rather than hidden behind a
				disclaimer at the bottom.
			</p>
		</div>
	</section>

	<section class="paper-2 mt-[var(--section-space)] py-[clamp(3.5rem,8vw,7rem)]">
		<div class="wrap flex flex-wrap items-end justify-between gap-x-16 gap-y-8">
			<h2 class="display-sm max-w-[18ch] text-ink" data-reveal>Start with your own quote.</h2>
			<a href="/calculators/" class="btn" data-reveal style="--reveal-delay:80ms">
				Open the calculators
				<span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</section>
</BaseLayout>
