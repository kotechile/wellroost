---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { fetchAllPosts, fetchPostsByCategory } from '../lib/wordpress';
import { getCategoryBySlug } from '../lib/categories';
import PostCard from '../components/PostCard.astro';
import { calculatorTools } from '../lib/calculators/metadata';

export async function getStaticPaths() {
	const posts = await fetchAllPosts(100);
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post }
	}));
}

const { post } = Astro.props;

if (!post) {
	return Astro.redirect('/404');
}

const formattedDate = post.date
	? new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
	: '';

// Three more pieces from the same subject, so the end of an article is not a dead end.
const category = post.categorySlug ? await getCategoryBySlug(post.categorySlug) : null;
const related = category?.wordpressCategoryId
	? (await fetchPostsByCategory(category.wordpressCategoryId, 4)).filter((item) => item.slug !== post.slug).slice(0, 3)
	: [];

const plainText = (value: string) => value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const firstParagraph = post.content.match(/^<p[^>]*>([\s\S]*?)<\/p>/);
const bodyHtml =
	firstParagraph && post.excerpt && plainText(firstParagraph[1]).slice(0, 110) === plainText(post.excerpt).slice(0, 110)
		? post.content.replace(firstParagraph[0], '').trim()
		: post.content;

const siteUrl = Astro.site?.toString() || 'https://wellroost.com/';
const postUrl = new URL(`/${post.slug}/`, siteUrl).toString();
const categoryUrl = post.categorySlug ? new URL(`/categories/${post.categorySlug}/`, siteUrl).toString() : null;

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'headline': post.title,
	'description': post.excerpt,
	'image': post.featuredImage || new URL('/og-share.png', siteUrl).toString(),
	'datePublished': post.date,
	'dateModified': post.modified || post.date,
	'author': { '@type': 'Organization', 'name': 'WellRoost Editorial Team', 'url': siteUrl },
	'publisher': {
		'@type': 'Organization',
		'name': 'WellRoost',
		'logo': { '@type': 'ImageObject', 'url': new URL('/og-share.png', siteUrl).toString() }
	},
	'mainEntityOfPage': { '@type': 'WebPage', '@id': postUrl }
};

const breadcrumbElements: Array<Record<string, unknown>> = [
	{ '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': siteUrl }
];

if (post.categoryLabel && post.categorySlug && categoryUrl) {
	breadcrumbElements.push({
		'@type': 'ListItem',
		'position': 2,
		'name': post.categoryLabel,
		'item': categoryUrl
	});
}

breadcrumbElements.push({
	'@type': 'ListItem',
	'position': breadcrumbElements.length + 1,
	'name': post.title,
	'item': postUrl
});

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'itemListElement': breadcrumbElements
};
---

<BaseLayout
	title={`${post.title} | WellRoost`}
	description={post.excerpt || `A WellRoost guide to ${post.title}.`}
	image={post.featuredImage}
	type="article"
>
	<meta slot="head" property="article:published_time" content={post.date ?? undefined} />
	<meta slot="head" property="article:modified_time" content={post.modified ?? post.date ?? undefined} />
	{post.categoryLabel && <meta slot="head" property="article:section" content={post.categoryLabel} />}

	<JsonLd slot="head" data={articleSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<link slot="head" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css" />
	<script slot="head" is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
	<script slot="head" is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>

	<article>
		<header class="wrap pt-[clamp(2rem,4.5vw,3.5rem)]">
			<div class="article-frame">
			<div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-[0.8125rem] text-ink-2">
				{
					post.categoryLabel && (
						<a href={categoryUrl ?? '/categories/'} class="text-pine transition-opacity hover:opacity-70">
							{post.categoryLabel}
						</a>
					)
				}
				{formattedDate && <span class="num">{formattedDate}</span>}
			</div>

			<h1 class="display-sm mt-5 max-w-[24ch] text-ink">{post.title}</h1>
			</div>
		</header>

		<div class="wrap mt-[clamp(1.5rem,3vw,2.5rem)]">
			<div class="article-frame">
				{
					post.featuredImage && (
						<figure class="w-full overflow-hidden bg-paper-3" data-reveal>
							<img
								src={post.featuredImage}
								alt={post.featuredImageAlt || post.title}
								class="aspect-[7/4] w-full object-cover"
								loading="eager"
								decoding="async"
							/>
						</figure>
					)
				}

				{
					post.excerpt && (
						<div class="field-dark mt-6 p-6 sm:p-8 lg:p-10" data-reveal style="--reveal-delay:80ms">
							<p class="max-w-[34ch] font-display text-[clamp(1.4rem,2.1vw,2rem)] leading-[1.14] tracking-[-0.02em] text-paper">
								{post.excerpt}
							</p>
						</div>
					)
				}
			</div>
		</div>

		<div class="wrap mt-[clamp(2rem,3.2vw,3rem)]">
			<div class="article-frame grid gap-12 lg:grid-cols-[minmax(0,40rem)_minmax(14rem,1fr)] lg:gap-16">
			<div>
				<div class="article-body" set:html={bodyHtml} />

				<div class="mt-14 bg-paper-2 p-6 sm:p-8">
					<p class="font-display text-[1.35rem] leading-tight text-ink">WellRoost Editorial</p>
					<p class="mt-3 max-w-[42ch] text-[1rem] leading-relaxed text-ink-2">
						Guides are written against the published formulas and link to the calculator they
						describe. If a number in this piece does not reproduce, that is a defect, and we want it.
					</p>
				</div>
			</div>

			<aside class="lg:sticky lg:top-28 lg:self-start">
				{
					related.length > 0 && (
						<div class="mb-10 hidden lg:block">
							<p class="text-[0.8125rem] text-ink-2">More in {category?.name ?? 'this subject'}</p>
							<ul class="mt-4 grid gap-3">
								{related.map((item) => (
									<li>
										<a
											href={`/${item.slug}/`}
											class="block max-w-[30ch] font-display text-[1.05rem] leading-snug text-ink transition-colors duration-150 hover:text-pine"
										>
											{item.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				<p class="text-[0.8125rem] text-ink-2">Run the math on your own numbers</p>
				<ul class="mt-4 grid">
					{
						calculatorTools.map((tool) => (
							<li>
								<a
									href={tool.href}
									class="group flex items-baseline justify-between gap-4 py-3.5 text-ink transition-colors hover:text-pine"
								>
									<span class="font-display text-[1.15rem] leading-tight">{tool.title}</span>
									<span aria-hidden="true" class="text-[0.875rem] transition-transform duration-200 group-hover:translate-x-1">
										&rarr;
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<a href="/categories/" class="btn-ghost mt-6">
					All articles
					<span class="arrow" aria-hidden="true">&rarr;</span>
				</a>
			</aside>
		</div>

		{
			related.length > 0 && (
				<section class="wrap section" aria-labelledby="related">
					<div class="flex flex-wrap items-end justify-between gap-6">
						<h2 id="related" class="h2 max-w-[20ch] text-ink">More on {category?.name ?? 'this subject'}.</h2>
						<a href={category ? `/categories/${category.slug}/` : '/categories/'} class="btn-ghost pb-2">
							All articles
							<span class="arrow" aria-hidden="true">&rarr;</span>
						</a>
					</div>
					<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{related.map((item) => (
							<PostCard post={item} />
						))}
					</div>
				</section>
			)
		}
	</article>
</BaseLayout>

<script>
	const initKaTeX = () => {
		// @ts-ignore - renderMathInElement is loaded globally via CDN
		if (typeof renderMathInElement !== 'undefined') {
			const articleBody = document.querySelector('.article-body');
			if (articleBody) {
				// @ts-ignore
				renderMathInElement(articleBody, {
					delimiters: [
						{ left: '$$', right: '$$', display: true },
						{ left: '\\[', right: '\\]', display: true },
						{ left: '\\(', right: '\\)', display: false }
					]
				});
			}
		} else {
			setTimeout(initKaTeX, 100);
		}
	};

	document.addEventListener('DOMContentLoaded', initKaTeX);
</script>