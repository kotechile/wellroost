---
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import SiteNav from '../components/SiteNav.astro';
import { ANALYTICS } from '../data/analytics.mjs';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Absolute or site-relative social preview image. Omit to fall back to the site mark. */
	image?: string | null;
	/** og:type — 'article' on posts, 'website' everywhere else. */
	type?: 'website' | 'article';
	/** Emitted as noindex,follow. Set on the 404 page so it cannot be indexed as content. */
	noindex?: boolean;
	/** Suppresses the top padding the nav reserves; used by pages that open on a full-bleed plate. */
	flushTop?: boolean;
}

const {
	title,
	description = 'WellRoost—The Decision Engine for Your Home. Built around a core ecosystem of interactive calculators and data-driven insights.',
	image = null,
	type = 'website',
	noindex = false,
	flushTop = false
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);

/**
 * Analytics. Values live in `src/data/analytics.mjs` (committed), environment wins when set.
 *
 * This layout had none at all, so "no traffic" on this property was really "no data". The id is
 * committed rather than left to a build argument the Dockerfile has to remember to declare; empty is
 * a build failure, not a silent no-op.
 */
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC || ANALYTICS.src;
const analyticsWebsiteId = import.meta.env.PUBLIC_ANALYTICS_WEBSITE_ID || ANALYTICS.websiteId;
const analyticsDomains = import.meta.env.PUBLIC_ANALYTICS_DOMAINS || ANALYTICS.domains;

if (!analyticsWebsiteId || !analyticsSrc) {
	throw new Error(
		'[analytics] no website id or tracker configured — refusing to build an unmeasured site. ' +
			'Set it in src/data/analytics.mjs or PUBLIC_ANALYTICS_WEBSITE_ID.'
	);
}

// Canonical is derived from the route, never hand-written per page: a page cannot ship without
// one, and it cannot disagree with the URL the sitemap advertises. Astro builds directory-style
// routes, so the canonical always carries the trailing slash the sitemap emits.
const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, site).toString();

// og:image must be absolute for every consumer (Slack, X, Facebook, Bing), and it must be a raster
// card. This defaulted to /favicon.svg, which is not a valid og:image for any major consumer: every
// LinkedIn, Reddit and Slack share rendered as an empty box, so the distribution work had no
// clickable preview to do its job with. 1200x630, per-page `image` still overrides.
const ogImage = image ? new URL(image, site).toString() : new URL('/og-share.png', site).toString();
const ogImageIsRaster = /\.(png|jpe?g|webp|avif|gif)$/i.test(new URL(ogImage).pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f2eee4" />
		<title>{title}</title>

		<!-- Crawl contract: one canonical, one robots directive, one set of social cards. -->
		<link rel="canonical" href={canonical} />
		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<meta name="robots" content="index, follow, max-image-preview:large" />
		)}

		<meta property="og:site_name" content="WellRoost" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		{ogImageIsRaster && <meta property="og:image:width" content="1200" />}
		{ogImageIsRaster && <meta property="og:image:height" content="630" />}
		{ogImageIsRaster && <meta property="og:image:alt" content={title} />}

		<meta name="twitter:card" content={ogImageIsRaster ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{analyticsWebsiteId ? (
			<script defer src={analyticsSrc} data-website-id={analyticsWebsiteId} data-domains={analyticsDomains}></script>
		) : null}

		<slot name="head" />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
		>
			Skip to content
		</a>
		<SiteNav />
		<SearchOverlay />
		<main id="main" class={flushTop ? '' : 'pt-[4.5rem]'}>
			<slot />
		</main>
		<Footer />

		{/*
			Entrance motion. Progressive: the `js` flag is set here, so with no script every
			revealed block is simply visible. One observer for the page, unobserved after firing.
		*/}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add('js');
				const items = Array.from(document.querySelectorAll('[data-reveal]'));
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduce || !('IntersectionObserver' in window)) {
					items.forEach((el) => el.classList.add('is-in'));
					return;
				}
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
				);
				items.forEach((el) => io.observe(el));
			})();
		</script>
	</body>
</html>
