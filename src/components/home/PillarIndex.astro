---
import { Image } from 'astro:assets';
import type { CategoryRecord } from '../../lib/categories';
import { getSubjectImage } from '../../lib/subjectImages';

interface Props {
	categories: CategoryRecord[];
	postCount: number;
}

const { categories, postCount } = Astro.props;
---

<section class="section wrap" aria-labelledby="subjects">
	<div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
		<div>
			<h2 id="subjects" class="h2 max-w-[18ch] text-ink" data-reveal>
				The archive, by subject.
			</h2>
			<p class="body mt-5 max-w-[36ch]" data-reveal style="--reveal-delay:70ms">
				Four subjects, one per kind of expense a house hands you.
				{postCount > 0 ? ` ${postCount} pieces so far,` : ''} each worked through the same arithmetic the
				calculators run.
			</p>
		</div>
		<a href="/categories/" class="btn-ghost pb-2" data-reveal style="--reveal-delay:120ms">
			All articles
			<span class="arrow" aria-hidden="true">&rarr;</span>
		</a>
	</div>

	<ul class="mt-[clamp(2rem,4vw,3rem)] grid">
		{
			categories.map((category, index) => {
				const cover = getSubjectImage(category.slug);
				return (
				<li data-reveal style={`--reveal-delay:${index * 60}ms`}>
					<a
						href={`/categories/${category.slug}/`}
						class="group grid items-center gap-4 bg-card p-4 text-ink transition-colors duration-200 hover:bg-paper-2 sm:gap-6 sm:p-5 md:grid-cols-[7.5rem_minmax(0,0.85fr)_minmax(0,1fr)_auto]"
					>
						{cover ? (
							<span class="block aspect-[4/3] w-full overflow-hidden bg-paper-3 md:w-[7.5rem]">
								<Image
									src={cover.src}
									alt={cover.alt}
									widths={[240, 360, 480]}
									sizes="7.5rem"
									loading="lazy"
									class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
								/>
							</span>
						) : (
							<span class="block aspect-[4/3] w-full bg-paper-3 md:w-[7.5rem]" />
						)}

						<span class="h3 max-w-[18ch] transition-colors duration-200 group-hover:text-pine">
							{category.name}
						</span>

						<span class="max-w-[44ch] text-[0.9375rem] leading-relaxed text-ink-2 line-clamp-2">
							{category.description}
						</span>

						<span class="flex items-baseline gap-4 text-[0.8125rem] text-ink-2">
							<span class="num">
								{category.postCount
									? `${category.postCount} ${category.postCount === 1 ? 'piece' : 'pieces'}`
									: 'In progress'}
							</span>
							<span
								aria-hidden="true"
								class="text-pine transition-transform duration-200 group-hover:translate-x-1"
							>
								&rarr;
							</span>
						</span>
					</a>
				</li>
				);
			})
		}
	</ul>
</section>
