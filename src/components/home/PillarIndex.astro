---
import type { CategoryRecord } from '../../lib/categories';

interface Props {
	categories: CategoryRecord[];
	postCount: number;
}

const { categories, postCount } = Astro.props;
---

<section class="section wrap" aria-labelledby="pillars">
	<div class="grid gap-10 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)] lg:gap-20">
		<div>
			<h2 id="pillars" class="h2 max-w-[18ch] text-ink" data-reveal>
				Where the guides will live.
			</h2>
			<p class="body mt-6 max-w-[34ch]" data-reveal style="--reveal-delay:70ms">
				{
					postCount > 0
						? 'Four pillars, one per kind of expense a house hands you. Each guide works a decision through the same math the calculators run.'
						: 'Four pillars, one per kind of expense a house hands you. The calculators are live now; the guides are being written into each pillar.'
				}
			</p>
			<a href="/categories/" class="btn-ghost mt-8" data-reveal style="--reveal-delay:120ms">
				Browse the pillars
				<span class="arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>

		<ul class="grid">
			{
				categories.map((category, index) => (
					<li data-reveal style={`--reveal-delay:${index * 70}ms`}>
						<a
							href={`/categories/${category.slug}/`}
							class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-6 text-ink transition-colors duration-200 hover:text-pine"
						>
							<span class="h3 max-w-[22ch]">{category.name}</span>
							<span class="num text-[0.8125rem] text-ink-2">
								{category.postCount ? `${category.postCount} ${category.postCount === 1 ? 'guide' : 'guides'}` : 'In progress'}
							</span>
							<span class="w-full text-[1rem] leading-relaxed text-ink-2 sm:max-w-[38ch]">
								{category.description}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
