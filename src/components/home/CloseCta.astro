<section class="paper-2 mt-[var(--section-space)] py-[clamp(3.5rem,8vw,7rem)]">
	<div class="wrap flex flex-wrap items-end justify-between gap-x-16 gap-y-10">
		<div class="max-w-[30ch]">
			<h2 class="h2 text-ink" data-reveal>Sign after the number.</h2>
			<p class="lede mt-6 max-w-[34ch]" data-reveal style="--reveal-delay:70ms">
				Three calculators, six inputs at most, every formula published on this page. No account and
				no sales call at the end of it.
			</p>
		</div>

		<div class="flex flex-col items-start gap-4 pb-2" data-reveal style="--reveal-delay:120ms">
			<a href="/calculators/" class="btn">
				Run a number
				<span aria-hidden="true">&rarr;</span>
			</a>
			<a href="/categories/" class="btn-ghost">
				Browse the articles
				<span class="arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</section>
