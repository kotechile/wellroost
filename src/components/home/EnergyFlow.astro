---
/**
 * The page's one illustration.
 *
 * A generative flow field: 2,200 hairlines on a Perlin noise field, steering through the house's
 * contour, up the chimney and along the energy path — roof, wall box, cable, car. Every part of the
 * picture is drawn by the same three primitives (noise, curl, vector steering), so nothing is a
 * sprite and nothing is a photograph of a decision.
 *
 * It replaces the three.js candy house: same slot, same argument — this is the house the three
 * engines model — but the motion now says what the engines actually do, which is move energy through
 * a building. Dark plate on paper, square corners, no chrome inside the frame.
 *
 * The frame is lazy: p5 loads when a visitor reaches it.
 */
const paths = [
	{ part: 'Windows', effect: 'Warm when the cursor crosses the house.' },
	{ part: 'Connector', effect: 'A click sends a pulse down the cable.' },
	{ part: 'Chimney', effect: 'The plume curls with the wind it is given.' }
];
---

<div class="paper-2 mt-[var(--section-space)]">
	<section class="wrap py-[clamp(3rem,6vw,5rem)]" aria-labelledby="model">
		<div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
			<h2 id="model" class="h2 max-w-[20ch] text-ink" data-reveal>
				A house, and the energy moving through it.
			</h2>
			<p class="body max-w-[34ch] pb-2" data-reveal style="--reveal-delay:80ms">
				Three things in this drawing decide most real home budgets: the envelope you heat, the
				car you charge, and whether you stay long enough to open the place up.
			</p>
		</div>

		<figure class="mt-[clamp(2rem,3.5vw,3rem)]">
			<div data-reveal style="--reveal-delay:120ms">
				<iframe
					src="/energy-flow.html"
					class="block h-[26rem] w-full border-0 sm:h-[30rem] lg:h-[36rem]"
					loading="lazy"
					title="Generative illustration: a modern house, its wall connector and an electric car drawn with particles"
					aria-describedby="model-caption"
				></iframe>
			</div>

			<figcaption class="mt-4 grid gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline">
				<p id="model-caption" class="caption">
					Generative illustration, drawn in the browser with p5. Hairlines follow a noise field
					around a house and its car; energy runs from the roof through the wall connector and
					along the sagging cable into the pack. Move the cursor and the field leans toward it;
					cross the house and the windows warm; click and a pulse travels the cable. It reads
					nothing from your inputs.
				</p>
				<dl class="flex flex-wrap gap-x-6 gap-y-1 text-[0.8125rem] text-ink-2">
					{
						paths.map((item) => (
							<div class="flex gap-2">
								<dt class="text-ink">{item.part}</dt>
								<dd>{item.effect}</dd>
							</div>
						))
					}
				</dl>
			</figcaption>
		</figure>
	</section>
</div>
