---
import { Image } from 'astro:assets';
import type { WordPressPost } from '../lib/wordpress';
import { getArticleImage } from '../lib/articleImages';

interface Props {
	post: WordPressPost;
	/** Larger first-card treatment for a featured slot. */
	feature?: boolean;
}

const { post, feature = false } = Astro.props;

// A clean plate made for the piece if one exists, otherwise the CMS share card.
const cover = getArticleImage(post.slug);

const formattedDate = post.date
	? new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
	: null;
---

<article class="group h-full">
	<a
		href={`/${post.slug}/`}
		class="flex h-full flex-col bg-card text-ink transition-colors duration-200 hover:bg-paper-2"
	>
		{/*
			The featured image is the article's own share card: a photographic composite with the
			headline set into it. At card size that type reads as texture, and it is the only picture
			the CMS carries per piece — so the card shows it rather than going bare.
		*/}
		{
			cover ? (
				<div class="aspect-[7/4] w-full overflow-hidden bg-paper-3">
					<Image
						src={cover.src}
						alt={cover.alt}
						widths={[420, 640, 900]}
						sizes="(min-width: 1024px) 30vw, 90vw"
						loading="lazy"
						class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
					/>
				</div>
			) : post.featuredImage ? (
				<div class="aspect-[7/4] w-full overflow-hidden bg-paper-3">
					<img
						src={post.featuredImage}
						alt={post.featuredImageAlt || ''}
						loading="lazy"
						decoding="async"
						class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
					/>
				</div>
			) : null
		}

		<div class="flex flex-1 flex-col justify-between p-5">
			<div>
				<h3
					class:list={[
						'max-w-[26ch] font-display leading-[1.06] text-ink transition-colors duration-200 group-hover:text-pine',
						feature ? 'text-[clamp(1.7rem,2.5vw,2.25rem)]' : 'text-[clamp(1.3rem,1.8vw,1.6rem)]'
					]}
				>
					{post.title}
				</h3>

				{post.excerpt && (
					<p class="mt-3 max-w-[40ch] text-[0.9375rem] leading-relaxed text-ink-2 line-clamp-3">
						{post.excerpt}
					</p>
				)}
			</div>

			<div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.8125rem]">
				<span class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-ink-2">
					{post.categoryLabel && <span>{post.categoryLabel}</span>}
					{formattedDate && <span class="num">{formattedDate}</span>}
				</span>
				<span class="inline-flex items-center gap-2 text-pine">
					Read
					<span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
				</span>
			</div>
		</div>
	</a>
</article>
