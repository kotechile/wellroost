---
import { Image } from 'astro:assets';
import type { WordPressPost } from '../lib/wordpress';

interface Props {
	post: WordPressPost;
	/** Larger first-card treatment for the homepage row. */
	feature?: boolean;
}

const { post, feature = false } = Astro.props;

const formattedDate = post.date
	? new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
	: null;

const fallbackPlate = feature ? 'aspect-[4/3]' : 'aspect-[16/10]';
---

<article class="group">
	<a href={`/${post.slug}/`} class="block text-ink">
		<div class:list={['overflow-hidden bg-paper-3', post.featuredImage ? fallbackPlate : 'hidden']}>
			{
				post.featuredImage && (
					<img
						src={post.featuredImage}
						alt={post.featuredImageAlt || ''}
						loading="lazy"
						decoding="async"
						class="h-full w-full object-cover grayscale-[0.85] contrast-[1.02] transition duration-500 ease-out group-hover:scale-[1.03] group-hover:grayscale-0"
					/>
				)
			}
		</div>

		<div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[0.8125rem] text-ink-2">
			{post.categoryLabel && <span class="text-pine">{post.categoryLabel}</span>}
			{formattedDate && <span class="num">{formattedDate}</span>}
		</div>

		<h3 class:list={['mt-2 max-w-[26ch] leading-[1.06] text-ink transition-colors duration-200 group-hover:text-pine', feature ? 'text-[clamp(1.6rem,2.4vw,2.15rem)] font-display' : 'text-[clamp(1.25rem,1.7vw,1.5rem)] font-display']}>
			{post.title}
		</h3>

		{post.excerpt && (
			<p class="mt-2 max-w-[42ch] text-[1rem] leading-relaxed text-ink-2 line-clamp-3">{post.excerpt}</p>
		)}

		<span class="mt-4 inline-flex items-center gap-2 text-[0.875rem] text-pine">
			Read
			<span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
		</span>
	</a>
</article>
