---
import type { WordPressPost } from '../lib/wordpress';

interface Props {
	post: WordPressPost;
	/** Larger first-card treatment for the homepage row. */
	feature?: boolean;
}

const { post, feature = false } = Astro.props;

const formattedDate = post.date
	? new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
	: null;
---

<article class="group h-full">
	<a
		href={`/${post.slug}/`}
		class="flex h-full flex-col justify-between bg-card p-6 text-ink transition-colors duration-200 hover:bg-paper-2"
	>
		<div>
			{/*
				No thumbnail. Every post's featured image on this CMS is the generated share card — the
				title set into a 1344x768 graphic — so printing it above the title rendered the headline
				twice and cropped it both times. Typography carries the card instead.
			*/}
			<h3
				class:list={[
					'mt-3 max-w-[26ch] font-display leading-[1.06] text-ink transition-colors duration-200 group-hover:text-pine',
					feature ? 'text-[clamp(1.6rem,2.4vw,2.15rem)]' : 'text-[clamp(1.3rem,1.8vw,1.6rem)]'
				]}
			>
				{post.title}
			</h3>

			{post.excerpt && (
				<p class="mt-3 max-w-[40ch] text-[0.9375rem] leading-relaxed text-ink-2 line-clamp-3">{post.excerpt}</p>
			)}
		</div>

		<div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.8125rem]">
			<span class="inline-flex items-center gap-2 text-pine">
				Read
				<span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
			</span>
			<span class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-ink-2">
				{post.categoryLabel && <span>{post.categoryLabel}</span>}
				{formattedDate && <span class="num">{formattedDate}</span>}
			</span>
		</div>
	</a>
</article>