---
import { fetchLatestPosts, hasWordPressApiBase } from '../lib/wordpress';
import PostCard from './PostCard.astro';

const posts = await fetchLatestPosts(6);
const hasApiBase = hasWordPressApiBase();
---

<section class="mt-24">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="section-eyebrow">Intelligence Feed</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-1000 sm:text-4xl">
				Latest Guides & Decisions
			</h2>
		</div>
		{
			hasApiBase ? (
				<p class="max-w-md text-sm leading-6 text-gray-500 font-mono">
					Live insights synced directly from the WellRoost repository.
				</p>
			) : (
				<p class="max-w-md text-sm leading-6 text-amber-600 font-mono">
					Notice: CMS synchronization offline.
				</p>
			)
		}
	</div>

	{
		posts.length ? (
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<div class="mt-8 rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-sm">
				<div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-gray-600 mb-4">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 00-2-2m-2-3V3m8 8h-6M21 12H9m0 0v-4" /></svg>
				</div>
				<h3 class="text-xl font-bold text-gray-1000">Articles Syncing</h3>
				<p class="mx-auto mt-2 max-w-lg text-sm text-gray-500 leading-relaxed">
					New guides and ROI case studies are continually added. Check back shortly for updated content.
				</p>
			</div>
		)
	}
</section>
