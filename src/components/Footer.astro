---
import { getTopLevelCategories } from '../lib/categories';

const topCategories = await getTopLevelCategories();

const columns = [
	{
		title: 'Engines',
		links: [
			{ href: '/calculators/move-or-improve/', label: 'Move or improve' },
			{ href: '/calculators/remodeling-roi/', label: 'Remodeling ROI' },
			{ href: '/calculators/remodelytics/', label: 'Remodelytics' }
		]
	},
	{
		title: 'Articles',
		links: topCategories.slice(0, 4).map((category) => ({
			href: `/categories/${category.slug}/`,
			label: category.name
		}))
	},
	{
		title: 'Site',
		links: [
			{ href: '/calculators/', label: 'All calculators' },
			{ href: '/categories/', label: 'All articles' },
			{ href: '/about/', label: 'About' },
			{ href: '/privacy/', label: 'Privacy' }
		]
	}
];
---

<footer class="field-dark mt-[var(--section-space)] pt-[clamp(3rem,6vw,5rem)]">
	<div class="wrap">
		<div class="grid gap-12 border-0 pb-16 md:grid-cols-[1.2fr_repeat(3,minmax(0,0.7fr))] md:gap-8">
			<div class="max-w-[22rem]">
				<p class="font-display text-[1.35rem] leading-none tracking-[-0.02em]">WellRoost</p>
				<p class="mt-4 text-[0.95rem] leading-relaxed text-paper/70">
					The decision engine for your home. Three calculators, the same math we publish, no
					account and no sales call.
				</p>
				<a href="/calculators/" class="btn btn-invert mt-7">
					Run a number
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>

			{
				columns.map((column) => (
					<div>
						<p class="text-[0.8125rem] text-paper/55">{column.title}</p>
						<ul class="mt-4 grid gap-2.5">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-[0.95rem] text-paper/90 transition-colors duration-150 hover:text-paper"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="pt-10">
			<p
				class="font-display leading-[0.78] tracking-[-0.045em] text-paper/95"
				style="font-size: clamp(3.4rem, 13.2vw, 12.5rem);"
				aria-hidden="true"
			>
				WellRoost
			</p>
		</div>

		<div class="mt-12 grid gap-6 pb-10 text-[0.8125rem] leading-relaxed text-paper/65 md:grid-cols-[1fr_auto]">
			<div class="grid max-w-[62ch] gap-3">
				<p>
					<strong class="font-medium text-paper/80">Analytics.</strong> We record anonymous
					interaction events and model parameters to check calculator accuracy and refine the engines.
					Field values are never sent. We do not sell data or run cross-site trackers. See the
					<a href="/privacy/" class="text-link">Privacy Policy</a>.
				</p>
				<p>
					<strong class="font-medium text-paper/80">Photography.</strong> Archival plates are public
					domain, from the Historic American Buildings Survey via Wikimedia Commons: Eleazer Arnold
					House (1937), Sherman Phelps House (1966), Isaac Bell House porch bracket (1969), Jacob
					Vanderbeck House (1938); Pratt residence first floor plan by McKim, Mead &amp; White. They
					show the era's housing stock, not properties we have modelled.
				</p>
			</div>
			<p class="md:text-right">&copy; {new Date().getFullYear()} WellRoost</p>
		</div>
	</div>
</footer>
