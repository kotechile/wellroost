---
import type { CategoryRecord } from '../lib/categories';
import type { WordPressPost } from '../lib/wordpress';

interface Props {
	categories: CategoryRecord[];
	postsByCategory?: Record<string, WordPressPost[]>;
}

const { categories, postsByCategory = {} } = Astro.props;

const accentPresets = [
	{
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
		color: 'text-blue-600',
		bg: 'bg-blue-50'
	},
	{
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />',
		color: 'text-emerald-600',
		bg: 'bg-emerald-50'
	},
	{
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />',
		color: 'text-amber-600',
		bg: 'bg-amber-50'
	},
	{
		icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />',
		color: 'text-purple-600',
		bg: 'bg-purple-50'
	}
];

const featuredCategories = categories.slice(0, 3);
const activeCategory = featuredCategories[0] ?? null;

function truncate(value: string, maxLength = 140) {
	if (value.length <= maxLength) {
		return value;
	}
	return `${value.slice(0, maxLength).trim()}...`;
}
---

<section id="pillars" class="mt-24 scroll-mt-32">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="section-eyebrow">Decision Pillars</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-1000 sm:text-4xl">
				Explore Knowledge by Pillar
			</h2>
		</div>
		<a href="/categories/" class="text-sm font-semibold text-primary transition hover:underline">
			View all pillars <span aria-hidden="true">&rarr;</span>
		</a>
	</div>

	<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			featuredCategories.map((category, index) => {
				const preset = accentPresets[index % accentPresets.length];
				const isActive = activeCategory?.slug === category.slug;
				const postCount = postsByCategory[category.slug]?.length ?? category.postCount ?? 0;
				
				return (
					<button
						type="button"
						id={`pillar-trigger-${category.slug}`}
						aria-pressed={isActive ? 'true' : 'false'}
						aria-controls={`pillar-posts-${category.slug}`}
						data-pillar-trigger={category.slug}
						data-active={isActive ? 'true' : 'false'}
						class="group relative flex min-h-48 cursor-pointer flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 text-left transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary data-[active=true]:border-primary data-[active=true]:ring-2 data-[active=true]:ring-primary/20 shadow-sm"
					>
						<div class="flex items-start justify-between">
							<div class={`p-3 rounded-xl ${preset.bg} ${preset.color}`}>
								<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={preset.icon} />
							</div>
							<span class="font-mono text-xs uppercase tracking-wider text-gray-400">
								{postCount} {postCount === 1 ? 'article' : 'articles'}
							</span>
						</div>
						
						<div class="mt-6">
							<h3 class="text-xl font-bold tracking-tight text-gray-1000 group-hover:text-primary transition-colors">
								{category.name}
							</h3>
							<p class="mt-2 text-sm text-gray-600 leading-relaxed line-clamp-2">
								{category.description || 'Guides, templates, and analytics to support decision-making in this area.'}
							</p>
						</div>
						
						<div class="mt-6 flex items-center justify-between text-xs font-semibold text-primary pt-3 border-t border-gray-100">
							<span>Explore pillar</span>
							<span class="inline-block transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
						</div>
					</button>
				);
			})
		}
	</div>

	<div id="pillar-results" class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
		{
			featuredCategories.map((category) => {
				const posts = postsByCategory[category.slug] ?? [];
				const isActive = activeCategory?.slug === category.slug;

				return (
					<section
						id={`pillar-posts-${category.slug}`}
						aria-labelledby={`pillar-trigger-${category.slug}`}
						data-pillar-panel={category.slug}
						hidden={!isActive}
					>
						<div class="flex flex-col gap-3 border-b border-gray-100 pb-5 sm:flex-row sm:items-end sm:justify-between">
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-primary">Featured in {category.name}</p>
								<h3 class="mt-1 text-2xl font-bold tracking-tight text-gray-1000">
									{category.name} Guides
								</h3>
							</div>
							<a href={`/categories/${category.slug}/`} class="text-xs font-mono font-semibold uppercase tracking-wider text-gray-500 hover:text-primary transition">
								View category page &rarr;
							</a>
						</div>

						{posts.length ? (
							<div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
								{posts.map((post) => (
									<a
										href={`/${post.slug}/`}
										class="group flex flex-col justify-between overflow-hidden rounded-xl border border-gray-200 bg-white p-5 transition duration-200 hover:-translate-y-1 hover:border-gray-300 hover:shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
									>
										<div>
											{post.featuredImage && (
												<div class="aspect-video w-full overflow-hidden rounded-lg border border-gray-100 mb-4 bg-gray-50">
													<img
														src={post.featuredImage}
														alt={post.featuredImageAlt || ''}
														loading="lazy"
														class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
													/>
												</div>
											)}
											<div class="flex items-center justify-between text-[11px] font-mono uppercase text-gray-400 mb-2">
												<span>{post.date ? new Date(post.date).toLocaleDateString() : 'Live'}</span>
											</div>
											<h4 class="text-lg font-bold leading-snug text-gray-1000 transition group-hover:text-primary">
												{post.title}
											</h4>
											<p class="mt-2 text-sm leading-relaxed text-gray-600 line-clamp-2">
												{post.excerpt ? truncate(post.excerpt) : 'Read the complete guide on WellRoost.'}
											</p>
										</div>
										<div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-primary">
											<span>Read article</span>
											<span class="inline-block transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
										</div>
									</a>
								))}
							</div>
						) : (
							<div class="py-12 text-center text-gray-500">
								<p class="font-mono text-sm">
									No articles are currently published in this pillar.
								</p>
							</div>
						)}
					</section>
				);
			})
		}
	</div>
</section>

<script>
	const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-trigger]'));
	const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-panel]'));
	const results = document.querySelector<HTMLElement>('#pillar-results');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function selectPillar(slug: string) {
		for (const trigger of triggers) {
			const isActive = trigger.dataset.pillarTrigger === slug;
			trigger.dataset.active = isActive ? 'true' : 'false';
			trigger.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		}

		for (const panel of panels) {
			panel.hidden = panel.dataset.pillarPanel !== slug;
		}

		results?.scrollIntoView({
			behavior: prefersReducedMotion ? 'auto' : 'smooth',
			block: 'nearest'
		});
	}

	for (const trigger of triggers) {
		trigger.addEventListener('click', () => {
			const slug = trigger.dataset.pillarTrigger;
			if (slug) {
				selectPillar(slug);
			}
		});
	}
</script>
