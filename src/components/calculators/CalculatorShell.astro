---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	variant?: 'light' | 'dark';
}

const { eyebrow, title, description, variant = 'light' } = Astro.props;

const isDark = variant === 'dark';
---

<section class="wrap pt-[clamp(2rem,4.5vw,3.5rem)]">
	<div class="grid items-end gap-x-14 gap-y-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
		<div>
			<p class:list={['text-[0.8125rem]', isDark ? 'text-paper/70' : 'text-ink-2']}>{eyebrow}</p>
			<h1 class:list={['display mt-3', isDark ? 'text-paper' : 'text-ink']}>{title}</h1>
		</div>
		<p class:list={['lede max-w-[42ch] pb-2', isDark ? 'text-paper/85' : 'text-ink']}>{description}</p>
	</div>

	<div class="mt-[clamp(2rem,4vw,3rem)] grid gap-8 lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,1fr)]">
		<div class="bg-card p-5 sm:p-7">
			<slot name="calculator" />
		</div>
		<div class="grid content-start gap-8">
			<slot name="aside" />
		</div>
	</div>
</section>
