PUBLIC_SITE_URL=https://wellroost.com
PUBLIC_WORDPRESS_API_BASE=https://cms.wellroost.com

# Privacy-first analytics — self-hosted Umami at umami.aichieve.net.
# The live id is committed in src/data/analytics.mjs (a public identifier, and the reason this
# property is measured at all); these variables override it for a staging build or a re-hosted
# instance. They are declared as build ARGs in the Dockerfile, so they do reach `astro build`.
PUBLIC_ANALYTICS_SRC=https://umami.aichieve.net/script.js
PUBLIC_ANALYTICS_WEBSITE_ID=
PUBLIC_ANALYTICS_DOMAINS=wellroost.com,www.wellroost.com

# Vibe-marketing telemetry (interactive asset events). BUILD-TIME: Astro inlines these into the
# bundle, so they must be set before `astro build` / in the Docker build args — not on the running
# container. With none of them set the app still builds; it warns in the console and hides the
# "Telemetry Enabled" badge instead of silently dropping events.
#
# The anon key is browser-safe by design: the table grants INSERT to `anon` and nothing else.
# PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
# Optional second sink, e.g. an n8n webhook for lead routing. The Coolify application carries this
# under the name PUBLIC_N8N_WEBHOOK_URL; both spellings are read (see src/lib/telemetry.ts) and both
# must appear as a Docker ARG or Docker drops the value before the bundle is built.
# PUBLIC_TELEMETRY_WEBHOOK_URL=https://n8n.example.com/webhook/wellroost-intent
# PUBLIC_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/wellroost-intent
