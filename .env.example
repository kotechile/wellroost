PUBLIC_SITE_URL=https://wellroost.com
PUBLIC_WORDPRESS_API_BASE=https://cms.wellroost.com

# Vibe-marketing telemetry (interactive asset events). BUILD-TIME: Astro inlines these into the
# bundle, so they must be set before `astro build` / in the Docker build args — not on the running
# container. With none of them set the app still builds; it warns in the console and hides the
# "Telemetry Enabled" badge instead of silently dropping events.
#
# The anon key is browser-safe by design: the table grants INSERT to `anon` and nothing else.
# PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
# Optional second sink, e.g. an n8n webhook for lead routing.
# PUBLIC_TELEMETRY_WEBHOOK_URL=https://n8n.example.com/webhook/wellroost-intent
